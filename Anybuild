# Pin PHP 8.4 for Wasmer/Anybuild. Symfony 8.1 (via Laravel 13) uses
# property hooks that PHP 8.3 cannot parse (Request.php syntax error).

load("//anybuild/tools:laravel.bzl", "laravel_build", "laravel_config")
load("//anybuild/tools:php.bzl", "php_serve")

config = laravel_config(
    schema = 1,
    node_package_manager = "npm",
    node_build_command = "npm run build",
    node_version = "24",
    php_framework = "laravel",
    composer_enable = True,
    composer_build_script = "post-update-cmd",
    php_version = "8.4",
    php_public_dir = "public",
)

build = laravel_build(config)

php_serve(
    config,
    build,
    name = "candidakuur",
    provider = "laravel",
    commands = {
        "start": "php -S 0.0.0.0:$PORT -t public",
        "after_deploy": "php artisan migrate --force",
    },
    prepare = [
        workdir(build.app.serve_path),
        run("mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache storage/framework/testing storage/logs bootstrap/cache"),
    ],
    build_post = [
        run("rm -rf node_modules"),
        run("composer install --no-dev --optimize-autoloader --ignore-platform-reqs --no-interaction"),
    ],
)
